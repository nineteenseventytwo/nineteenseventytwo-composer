# Ansible targets for the composer infra layer.
# Run FROM the console Pi (1972-console-1) — this directory is checked out at
# ~/nineteenseventytwo-composer/infra/ansible/
#
# Inventory:  /etc/ansible/hosts  (generated by server/make init-console-config)
# No cross-repo paths; hosts file is managed independently by the server layer.

.PHONY: init-gpu ping-gpu

# Sets up the PC Linux boot (Ubuntu 24.04) as a GPU worker node in the cluster.
# Prerequisites:
#   - bootstrap-linux.sh run on the GPU PC
#   - [gpu_nodes] entry live in /etc/ansible/hosts (run server/make init-console-config first)
init-gpu:
	@echo "Setting up GPU node (PC Linux boot)..."
	@if [ -n "$$SUDO_PASSWORD" ]; then \
		echo "$$SUDO_PASSWORD" > /tmp/.ansible_become_pass; \
		chmod 600 /tmp/.ansible_become_pass; \
		ansible-playbook playbooks/setup-gpu-node.yaml \
			--become-password-file /tmp/.ansible_become_pass; \
		rm -f /tmp/.ansible_become_pass; \
	else \
		ansible-playbook playbooks/setup-gpu-node.yaml -K; \
	fi

# Quick connectivity check against the GPU node
ping-gpu:
	ansible gpu_nodes -m ping
